# Dependencies (zero runtime deps; only dev deps live here)
node_modules/

# TypeScript incremental build metadata
*.tsbuildinfo

# Node test runner / coverage
coverage/

# Runtime state produced by the primitives when run inside a workspace.
# Everything lives under a single .agentflow/ dir (.agentflow/<cmd>/<run-id>/, .agentflow/cache, .agentflow/knowledge).
# Never commit run state — it is per-invocation, per-machine.
.agentflow/

# Claude Code local working docs & machine-specific settings — never published.
# STATUS.md/HISTORY.md are internal session bridges (local paths, roadmap) — kept out of the public repo.
.claude/STATUS.md
.claude/HISTORY.md
.claude/settings.local.json
.claude/*.local.json

# OS / editor cruft
.DS_Store
Thumbs.db

# NOTE: dist/ is intentionally NOT ignored — compiled JS is committed and run via node.
