# Dependencies (zero runtime deps; only dev deps live here)
node_modules/

# TypeScript incremental build metadata
*.tsbuildinfo

# Node test runner / coverage
coverage/

# Runtime state produced by the primitives when run inside a workspace.
# Never commit run state — it is per-invocation, per-machine.
.enumerate/
.group/
.iterate/
.pipe/
.reduce/
.knowledge/
.cache/

# Claude Code local (machine-specific) settings. STATUS.md stays tracked.
.claude/settings.local.json
.claude/*.local.json

# OS / editor cruft
.DS_Store
Thumbs.db

# NOTE: dist/ is intentionally NOT ignored — compiled JS is committed and run via node.
